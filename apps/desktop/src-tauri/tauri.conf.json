{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Corivo Community",
  "version": "0.4.6",
  "identifier": "ai.corivo.desktop.community",
  "build": {
    "beforeDevCommand": "node src-tauri/scripts/prep-sidecar.mjs && pnpm dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node src-tauri/scripts/prep-sidecar.mjs release && pnpm build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Corivo",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "quick-ask",
        "url": "quick-ask.html",
        "title": "Corivo Quick Ask",
        "width": 640,
        "height": 140,
        "minWidth": 480,
        "minHeight": 100,
        "maxWidth": 1200,
        "maxHeight": 900,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/corivo-mcp",
      "binaries/corivo-agent"
    ],
    "resources": {
      "binaries/CorivoCaptureHelper.app": "CorivoCaptureHelper.app",
      "../bundled-skills": "bundled-skills"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "Parent.entitlements"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["corivo-community"]
      }
    }
  }
}
