<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Corivo.app entitlements.

  Two responsibilities:
    1. Declare the TCC categories Corivo (and its embedded helper) ever
       touch. Microphone / audio-input / Apple Events are listed even
       though the calls happen inside corivo-capture-helper — they need
       to be on the responsible process (us) for tccd to attribute the
       request back, and on the helper too so Hardened Runtime allows
       the syscall once granted.
    2. Allow Tauri/wry/WebKit to JIT and load WKWebView's bundled libs.
       cs.allow-jit + cs.disable-library-validation are the standard
       pair Tauri docs recommend; without them WKWebView crashes on
       launch under Hardened Runtime.

  No sandbox: app-sandbox would require declaring every file access
  pattern up front, which conflicts with the user pinning arbitrary
  screenshots from $APPDATA. Sandboxing is a separate workstream, not
  on the critical path for CO-31.
-->
<plist version="1.0">
<dict>
  <!-- Hardened Runtime: WebKit / Tauri runtime -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Network -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!-- TCC categories used by the helper (responsible-process attribution
       requires these on the parent too, not just the helper) -->
  <key>com.apple.security.device.microphone</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
