{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@repo/tsconfig/node.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["bun"],
    "strict": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "outDir": "dist",
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*", "tests/**/*"]
}
