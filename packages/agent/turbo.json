        "src/**",
        "build.mjs",
        "package.json",
        "tsconfig.json"
      ],
      "outputs": [
        "../../apps/desktop/src-tauri/binaries/corivo-agent-aarch64-apple-darwin",
        "../../apps/desktop/src-tauri/binaries/corivo-agent-x86_64-apple-darwin",
        "../../apps/desktop/src-tauri/binaries/corivo-agent-universal-apple-darwin",
        "../../apps/desktop/src-tauri/binaries/corivo-agent-x86_64-pc-windows-msvc.exe"
